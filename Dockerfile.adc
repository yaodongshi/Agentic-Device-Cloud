# ADC Go services image: multi-stage, alpine runtime, non-root (design/60 2.x).
# alpine (not distroless) is chosen so the healthcheck has busybox wget;
# multi-arch build: docker buildx build --platform linux/amd64,linux/arm64 .

FROM golang:1.26-alpine@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468 AS build
WORKDIR /src
COPY go.work go.work.sum ./
COPY core-sdk/ core-sdk/
COPY ce/ ce/
WORKDIR /src/ce
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/adc ./cmd/adc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gateway ./cmd/gateway && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/adc-migrate ./cmd/adc-migrate

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache ca-certificates && \
    adduser -D -u 65532 adc
COPY --from=build /out/adc /out/gateway /out/adc-migrate /usr/local/bin/
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/adc"]
