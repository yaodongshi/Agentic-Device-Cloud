# ADC console image: nginx serving the built Vue SPA and proxying API
# traffic to the unified gateway (ADR-19). nginx is the ONLY public entry:
# one URL, one product (design/60 3.4).
FROM node:22-alpine AS build
WORKDIR /src
COPY ce/console/package.json ce/console/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ce/console/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
