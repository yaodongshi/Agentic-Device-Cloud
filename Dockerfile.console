# ADC console image: nginx serving the built Vue SPA and proxying API
# traffic to the unified gateway (ADR-19). nginx is the ONLY public entry:
# one URL, one product (design/60 3.4).
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
WORKDIR /src
COPY ce/console/package.json ce/console/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ce/console/ ./
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
