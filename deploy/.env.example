# ADC 开发环境变量样例：复制为 deploy/.env 后按需修改（.env 不入库）
# 开发 build 可使用以下本地 tag；生产必须改为 tag@sha256:digest。
ADC_CE_IMAGE=adc/ce:dev
ADC_PY_AGENT_IMAGE=adc/py-agent:dev
ADC_CONSOLE_IMAGE=adc/console:dev
# ADC_ENV=dev
ADC_PG_USER=adc
ADC_PG_PASSWORD=adc_dev_only
ADC_PG_DBNAME=adc
# SEC-06：Valkey ACL 用户。密码须与 deploy/valkey-acl.conf 中 adc 用户同步，
# 修改后两处必须一起更新。
ADC_VALKEY_USERNAME=adc
ADC_VALKEY_PASSWORD=adc_dev_only
# SEC-05：TLS 终结（dev 默认关闭）。开启时证书路径为容器内路径，
# 需随 compose 卷挂载证书（生产经 secrets 注入，design/60 7.1）。
ADC_TLS_ENABLE=false
ADC_TLS_CERT=
ADC_TLS_KEY=

# 显式开发 seed：docker compose -f deploy/compose.yaml --profile dev-seed run --rm dev-seed
# 以下凭证无仓库默认值，必须由开发者显式提供；seed 日志不会输出其值。
ADC_DEV_SEED_CNC_SECRET=
ADC_DEV_SEED_AGV_SECRET=
ADC_DEV_SEED_ADMIN_PASSWORD=
ADC_DEV_SEED_TENANT_ADMIN_PASSWORD=
ADC_DEV_SEED_APPROVER_PASSWORD=
# 格式 adc_<8位十六进制ID>_<至少32字符secret>
ADC_DEV_SEED_AGENT_API_KEY=
